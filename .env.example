# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional. Supabase project settings -> API -> service_role (secret) key.
# Only used server-side, to create Staff accounts pre-confirmed from the
# Admin > Users screen. Without it the app falls back to a normal sign-up,
# which requires the new staff member to confirm their email address.
SUPABASE_SERVICE_ROLE_KEY=
