# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Required to add staff. Supabase project settings -> API -> service_role
# (secret) key. Used server-side only, to invite or create accounts from the
# Admin > Users screen.
#
# The code falls back to an ordinary sign-up without it, but that fallback no
# longer works: public signup is disabled on this project, so it returns
# 422 signup_disabled. Adding staff fails outright rather than degrading.
SUPABASE_SERVICE_ROLE_KEY=
