# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Required to add staff. Supabase project settings -> API -> service_role
# (secret) key. Used server-side only, to invite or create accounts from the
# Admin > Users screen.
#
# Missing this key disables account creation, reset and deletion.
# Configure it only on the server; ordinary public signup is disabled.
SUPABASE_SERVICE_ROLE_KEY=
